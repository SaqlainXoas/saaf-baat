# Local API; use your https://...onrender.com URL on Vercel.
BACKEND_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_STRICT_LIVE_DATA=1

# Public site origin. Without it, page metadata and robots.txt fall back to
# localhost, which would ship localhost URLs in the production page head.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Server-only. Required for the hosted setup: the pipeline posts here after it
# publishes so the cached brief is replaced immediately instead of waiting out
# the revalidate window. Use the same value as the SAAF_REVALIDATE_SECRET
# GitHub Actions secret. The route fails closed when this is unset.
# REVALIDATE_SECRET=GENERATE_A_LONG_RANDOM_SECRET
