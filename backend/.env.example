# Saaf Baat backend environment template
# Copy to backend/.env and fill with your own values.

# Supabase Configuration
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY

# Google Gemini API
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Groq editorial layer
GROQ_API_KEY=YOUR_GROQ_API_KEY
SAAF_ENABLE_EDITORIAL_LLM=1
SAAF_EDITORIAL_GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Groq model name (fallback). Backward-compatible: if unset, code will also read SAAF_EDITORIAL_LLM_MODEL.
SAAF_EDITORIAL_GROQ_MODEL=openai/gpt-oss-120b
# Backward-compatible legacy name (still supported):
SAAF_EDITORIAL_LLM_MODEL=openai/gpt-oss-120b
SAAF_EDITORIAL_CANDIDATE_LIMIT=15
SAAF_EDITORIAL_MAX_STORIES=9

# Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS (comma-separated origins for frontend apps)
# Production should list exact origins and must not include '*'
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:3000,https://staging.example.com,https://app.example.com

# Pipeline heartbeat + health freshness
# Used by /health to expose last successful run + stale signal
SAAF_PIPELINE_HEARTBEAT_FILE=backend/.pipeline_heartbeat.json
SAAF_FEED_STALE_AFTER_HOURS=6

# Cost controls (safe hourly defaults)
SAAF_LOW_COST_MODE=1
SAAF_MAX_ARTICLES_PER_SOURCE=20
SAAF_EMBEDDING_BACKFILL_LIMIT=50
SAAF_ENABLE_PLAYWRIGHT_FALLBACK=0
