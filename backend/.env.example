# Saaf Baat backend environment template
# Copy to backend/.env and fill with your own values. Never put a real key in
# this tracked template; CI and GitHub push protection reject credentials.

# Database
# 'sqlite' (default) stores everything in a local file — no external service.
# 'supabase' switches to the hosted Postgres client and needs the keys below.
SAAF_DB_BACKEND=sqlite
# Path is relative to backend/ unless absolute.
SAAF_SQLITE_PATH=data/saafbaat.db

# Supabase Configuration (only used when SAAF_DB_BACKEND=supabase)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_KEY=YOUR_SERVER_SECRET_OR_SERVICE_ROLE_KEY
# Hosted access is server-only; never use this key in frontend code.

# Google Gemini API
# Used for embeddings, headline triage, split/merge adjudication, and the
# editorial pass. Triage replaced config/classification_rules.yaml.
# Without this key the pipeline cannot triage, and an untriaged cluster is not
# publishable - the run reports triage_status and /health says so.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SAAF_ENABLE_TRIAGE_LLM=1
SAAF_TRIAGE_MODEL=gemini-3.5-flash-lite
SAAF_ENABLE_ADJUDICATION_LLM=1
SAAF_ADJUDICATION_MODEL=gemini-3.5-flash-lite

# Editorial layer
# Gemini is the only editorial model. Groq was removed 2026-08-25: its free
# tier allows 8,000 tokens per minute for openai/gpt-oss-120b, prompt and
# completion together, which a 6-12 card brief over a 30-candidate shortlist
# does not fit inside. Every run spent a 413 and a rate-limit wait before
# falling through to Gemini anyway.
SAAF_ENABLE_EDITORIAL_LLM=1
SAAF_ENABLE_STORY_ANALYSIS_LLM=1
SAAF_STORY_ANALYSIS_MODEL=gemini-3.5-flash-lite
SAAF_EDITORIAL_GEMINI_MODEL=gemini-3.5-flash-lite
SAAF_EDITORIAL_CANDIDATE_LIMIT=30
SAAF_EDITORIAL_MAX_STORIES=12

# Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS (comma-separated origins for frontend apps)
# Production should list exact origins and must not include '*'
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:3000,https://staging.example.com,https://app.example.com

# Pipeline heartbeat state
# Used by /health to expose run timestamps, degraded sources, and stale signal
SAAF_PIPELINE_HEARTBEAT_FILE=backend/.pipeline_heartbeat.json

# Cost controls (daily pipeline)
# Ingest itself is cheap (~26 requests per run); the cap exists to bound
# embedding calls and event-grouping work, not network traffic.
SAAF_LOW_COST_MODE=1
SAAF_MAX_ARTICLES_PER_SOURCE=40
SAAF_EMBEDDING_BACKFILL_LIMIT=50
